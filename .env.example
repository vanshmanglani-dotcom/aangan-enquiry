# Supabase (Project Settings -> API)
SUPABASE_URL=                 # auto-set by Vercel Supabase integration
SUPABASE_SECRET_KEY=          # auto-set by Vercel Supabase integration
# Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Telegram (@BotFather token + designers' group chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HubSpot (Settings -> Integrations -> Private Apps, scope crm.objects.deals.write + contacts.write)
HUBSPOT_TOKEN=
# Cal.com booking link the designer note points to
CAL_LINK=https://cal.com/aangan-studio/site-visit
# Shared secret appended to the webhook URL: /api/vaani-webhook?secret=...
WEBHOOK_SECRET=
# Vaani per-minute cost estimate (INR)
VAANI_RATE_PER_MIN=5.6
